{
    "name": "framework-one/fw1-php",
    "description": "PHP port of the FW/1 framework, ported from the CFML source.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Framework\\": "framework/",
            "App\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
